{
    admin off
    auto_https off
}
:8080 {
    encode zstd gzip
    header {
        Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
        Cross-Origin-Opener-Policy same-origin
        Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), microphone=(), payment=(), usb=()"
        X-Frame-Options DENY
        Referrer-Policy no-referrer
        X-Content-Type-Options nosniff
    }
    handle /healthz {
        respond "ok" 200
    }
    handle /api/* {
        header Cache-Control "no-store"
        reverse_proxy web-panel:8000 {
            header_up -X-Autobot-Edge
        }
    }
    # Documentation site (ADR-018), built into the image at /srv/docs. It needs a panel
    # session: `forward_auth` asks `web-panel` whether the cookie is a verified staff session
    # (the same check as every panel API call) and sends anyone else to the login screen.
    handle /docs {
        redir * /docs/ 308
    }
    handle /docs/* {
        forward_auth web-panel:8000 {
            uri /api/panel/auth/me
            header_up -X-Autobot-Edge
            @denied status 401 403
            handle_response @denied {
                redir * /login 302
            }
        }
        # The generated pages carry a few inline scripts (theme, base URL, config) whose
        # hash changes with each page's depth, so script-src needs 'unsafe-inline' here
        # and only here. Everything else stays 'self'; nothing is loaded from a CDN.
        header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        root * /srv
        try_files {path} {path}/index.html
        file_server
    }
    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}
