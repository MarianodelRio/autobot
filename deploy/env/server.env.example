# Store as var/server.env (git-ignored, under /var/) with mode 0600; never commit
# values. Only `deploy/scripts/server-migrate.sh` (T4, `make server-migrate`) reads it
# now (PUBLIC_HOST); the VM is installed from inside with `install-vm.sh` (ADR-017),
# whose options replace the rest of these variables.

# The machine and how to reach it the first time (A15 step 1-2; SSH_USER is the
# initial login some providers set up, e.g. `ubuntu` or `root` -- not used again
# once `deploy`/`admin` exist).
HOST=
SSH_USER=root

# What the server will answer to, and where the code comes from.
PUBLIC_HOST=
REPO_URL=https://github.com/<owner>/<repo>.git
AUTOBOT_IMAGE=ghcr.io/<owner>/autobot
AUTOBOT_PANEL_IMAGE=ghcr.io/<owner>/autobot-panel

# Local files server-init.sh uploads or installs; never generated on the server
# side without your say, per bloque A/CLAUDE.md.
OPERATOR_PUBKEY=~/.ssh/id_ed25519_autobot_operator.pub
GOOGLE_SA_FILE=var/google_sa.json

# Backups (A3/A17): an R2 or B2 bucket in another region/provider than the VPS.
# `restic init` is never automatic; server-init.sh runs it once, with confirmation.
RESTIC_REPOSITORY=
RESTIC_PASSWORD_FILE=var/restic-password
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
HEALTHCHECKS_BACKUP_PING_URL=

# External monitoring (A17).
HEALTHCHECKS_PING_URL=
SENTRY_DSN=

# Channels and the panel (B1/B2).
DEMO_TELEGRAM_TOKEN=
NOTIFY_BOT_TOKEN=
OPS_TELEGRAM_CHAT_ID=
OWNER_SUPPORT_EMAIL=
PANEL_USER=panel
