# Store as /srv/autobot/var/backup.env with mode 0600; never commit values.
#
# The server only UPLOADS (ADR-021): the S3 key below may delete only under the
# repository's locks/ prefix (restic backup always creates and removes its lock file),
# nothing else and never s3:DeleteObjectVersion; enable bucket versioning, so an object
# overwritten by a compromised server can still be recovered.
# Expiring old snapshots is deploy/scripts/backup-prune.sh, run from the operator's machine
# with ANOTHER key that does have delete permission and never lives on the server. That
# machine's ~/.config/autobot/backup-prune.env (mode 0600) holds only:
#   RESTIC_REPOSITORY=<the same repository>
#   RESTIC_PASSWORD_FILE=<file with the restic password>   # or RESTIC_PASSWORD_COMMAND=...
#   AWS_ACCESS_KEY_ID=<the delete-capable key>
#   AWS_SECRET_ACCESS_KEY=<its secret>
RESTIC_REPOSITORY=s3:https://s3.example.invalid/autobot
RESTIC_PASSWORD_FILE=/srv/autobot/var/restic-password
AWS_ACCESS_KEY_ID=replace-me-upload-only-key
AWS_SECRET_ACCESS_KEY=replace-me
HEALTHCHECKS_BACKUP_PING_URL=https://hc-ping.com/replace-me
