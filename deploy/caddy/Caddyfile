{
    servers {
        timeouts {
            read_header 10s
            read_body 30s
            write 60s
            idle 2m
        }
    }
}

{$PUBLIC_HOST} {
    # Access log to stdout (collected by Docker's json-file driver) without the query
    # string (WhatsApp's webhook verification carries its verify token there) and
    # without request headers (webhook signatures, cookies).
    log {
        output stdout
        format filter {
            wrap json
            request>uri regexp \?.* ""
            request>headers delete
            resp_headers delete
        }
    }

    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options nosniff
        -Server
    }

    # Webhook payloads are small; Django enforces the same 256 KB.
    request_body {
        max_size 256KB
    }

    # /health/internal (the tenant/database detail deploy.sh needs) is deliberately
    # not listed here: it falls through to the 404 below for anyone outside the
    # docker network or 127.0.0.1.
    @public path /webhooks/whatsapp/* /webhooks/telegram/* /webhooks/telegram-demo /webhooks/whatsapp-demo /webhooks/telegram-notify /health
    handle @public {
        reverse_proxy web:8000 {
            header_up X-Autobot-Edge public
        }
    }
    handle {
        respond 404
    }
}
