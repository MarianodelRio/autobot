[Unit]
Description=Autobot host watchdog (disk, database, host snapshot) with a direct Telegram alert
# After, not Requires: with Docker down it must still run, and say so.
After=docker.service

[Service]
Type=oneshot
User=deploy
WorkingDirectory=/srv/autobot
ExecStart=/srv/autobot/deploy/scripts/watchdog.sh
# Every curl has its own 10 s limit; this only guards against a hung docker call.
TimeoutStartSec=60
