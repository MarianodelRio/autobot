# Copy to .env (never commit it).
# Production: ENVIRONMENT=prod, replace every local password/key/host below, and set
# PUBLIC_HOST=api.example.com plus SHA=<full published commit SHA>. Keep localhost and
# 127.0.0.1 in DJANGO_ALLOWED_HOSTS for the Admin SSH tunnel.
# The three FP/POSTGRES
# passwords must match the DB URLs. Keep .env mode 0600 on the server.
PUBLIC_HOST=
SHA=
# Numeric `id -u deploy` on the VPS; owns the mode-0600 mounted files.
DEPLOY_UID=
ENVIRONMENT=local
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO

# Database. Locally, compose.yaml sets these itself (local-only
# passwords) and publishes db on 127.0.0.1:5433; these are the values the tests use from
# the host. In production, FP_*_PASSWORD and the password inside each DB_*_URL must be the
# same, URL-encoded in the URL (e.g. ' → %27); hex passwords avoid the issue.
POSTGRES_PASSWORD=postgres
FP_OWNER_PASSWORD=fp_owner
FP_APP_PASSWORD=fp_app
DB_APP_URL=postgres://fp_app:fp_app@localhost:5433/flowpilot
DB_OWNER_URL=postgres://fp_owner:fp_owner@localhost:5433/flowpilot

# Channel secrets of every tenant. In local, secrets.yaml at the
# repository root (ignored by git); in production, mounted read-only.
SECRETS_FILE=secrets.yaml

# WhatsApp Cloud API.
WHATSAPP_GRAPH_VERSION=v23.0

# Test bot. In local, a development bot of your own: its token
# from @BotFather and your Telegram id. The webhook secret is only needed on the server
# (32+ random characters); in local, `make telegram-poll` needs none.
TEST_BOT_TOKEN=
TEST_BOT_WEBHOOK_SECRET=
TEST_BOT_OPERATORS=

# Public base URL of the webhooks (https://api.<dominio>); only `telegram_set_webhook`
# uses it, on the server.
PUBLIC_URL=

# Outbound notification bot and operation chat.
NOTIFY_BOT_TOKEN=
OPS_TELEGRAM_CHAT_ID=

# Observability. Empty values disable external integrations locally.
SENTRY_DSN=
HEALTHCHECKS_PING_URL=
RELEASE_SHA=
SERVICE_NAME=web
GOOGLE_SERVICE_ACCOUNT_FILE=

# Retención destructiva: mantener false hasta aprobación humana explícita.
# El trabajo nocturno (03:00 UTC) comprueba este permiso también al ejecutarse.
RETENTION_CLEANUP_ENABLED=false
