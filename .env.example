# Copy to .env (never commit it). Variables: design.md §5.3.
ENVIRONMENT=local
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO

# Database (design.md §12.2). Locally, compose.yaml sets these itself (local-only
# passwords) and publishes db on 127.0.0.1:5433; these are the values the tests use from
# the host. In production, FP_*_PASSWORD and the password inside each DB_*_URL must be the
# same, URL-encoded in the URL (e.g. ' → %27); hex passwords avoid the issue.
POSTGRES_PASSWORD=postgres
FP_OWNER_PASSWORD=fp_owner
FP_APP_PASSWORD=fp_app
DB_APP_URL=postgres://fp_app:fp_app@localhost:5433/flowpilot
DB_OWNER_URL=postgres://fp_owner:fp_owner@localhost:5433/flowpilot

# Channel secrets of every tenant (design.md §5.3). In local, secrets.yaml at the
# repository root (ignored by git); in production, mounted read-only.
SECRETS_FILE=secrets.yaml

# WhatsApp Cloud API (design.md §6.3).
WHATSAPP_GRAPH_VERSION=v23.0

# Test bot (design.md §6.5). In local, a development bot of your own (M-3.1): its token
# from @BotFather and your Telegram id. The webhook secret is only needed on the server
# (32+ random characters); in local, `make telegram-poll` needs none.
TEST_BOT_TOKEN=
TEST_BOT_WEBHOOK_SECRET=
TEST_BOT_OPERATORS=
