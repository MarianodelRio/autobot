# Copy to .env (never commit it).
# Production: ENVIRONMENT=prod, replace every local password/key/host below, and set
# PUBLIC_HOST=api.example.com plus SHA=<full published commit SHA>. Keep localhost and
# 127.0.0.1 in DJANGO_ALLOWED_HOSTS for the panel SSH tunnel.
# The FP_* and POSTGRES
# passwords must match the DB URLs. Keep .env mode 0600 on the server.
COMPOSE_FILE=deploy/compose/compose.yaml:deploy/compose/compose.local.yaml
# Production value: deploy/compose/compose.yaml:deploy/compose/compose.prod.yaml
COMPOSE_PROJECT_NAME=autobot
PUBLIC_HOST=
SHA=
# Production only (deploy/compose/compose.prod.yaml); e.g. ghcr.io/<owner>/autobot.
AUTOBOT_IMAGE=
AUTOBOT_PANEL_IMAGE=
# Numeric `id -u deploy` on the VPS; owns the mode-0600 mounted files.
DEPLOY_UID=
ENVIRONMENT=local
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO

# Database. Locally, compose.local.yaml sets these itself (local-only
# passwords) and publishes db on 127.0.0.1:5433; these are the values the tests use from
# the host. In production, FP_*_PASSWORD and the password inside each DB_*_URL must be the
# same, URL-encoded in the URL (e.g. ' → %27); hex passwords avoid the issue.
POSTGRES_PASSWORD=postgres
FP_OWNER_PASSWORD=fp_owner
FP_APP_PASSWORD=fp_app
FP_READONLY_PASSWORD=fp_readonly
DB_APP_URL=postgres://fp_app:fp_app@localhost:5433/autobot
DB_OWNER_URL=postgres://fp_owner:fp_owner@localhost:5433/autobot
DB_READONLY_URL=postgres://fp_readonly:fp_readonly@localhost:5433/autobot

# Fernet keys, comma-separated: first encrypts, all decrypt. Local default only.
# Generate: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRETS_ENCRYPTION_KEY=UHx17yr1uv1SdskJ5dGpF1MYUPfD2ierqd5mY_2AQ_w=

# WhatsApp Cloud API.
WHATSAPP_GRAPH_VERSION=v23.0

# Bot de demo (Telegram). En local, un bot de desarrollo propio: su token de
# @BotFather y tu id de Telegram. El secreto de webhook solo hace falta en el
# servidor (32+ caracteres aleatorios); en local, `make telegram-poll` no lo necesita.
DEMO_TELEGRAM_TOKEN=
DEMO_TELEGRAM_WEBHOOK_SECRET=
DEMO_TELEGRAM_USERS=

# Bot de demo (WhatsApp). Solo funciona en el servidor (un número de Meta tiene una
# única URL de webhook): los cinco ids/secretos de abajo deben tener valor a la vez
# para que la puerta se encienda. DEMO_WHATSAPP_USERS: teléfonos (solo dígitos, con
# prefijo de país) o BSUID, separados por comas.
DEMO_WHATSAPP_PHONE_NUMBER_ID=
DEMO_WHATSAPP_WABA_ID=
DEMO_WHATSAPP_DISPLAY_PHONE=
DEMO_WHATSAPP_APP_SECRET=
DEMO_WHATSAPP_ACCESS_TOKEN=
DEMO_WHATSAPP_VERIFY_TOKEN=
DEMO_WHATSAPP_USERS=
DEMO_WHATSAPP_MONTHLY_ALERT_THRESHOLD=300

# Calendario de Google del `salon` de demo (compartido con la cuenta de servicio);
# `seed_demos` lo aplica al crear el demo. Sin él, el demo no reserva de verdad.
DEMO_SALON_CALENDAR_ID=

# Solo en local: dominio reservado de ngrok para `make ngrok`.
NGROK_DOMAIN=

# Public base URL of the webhooks (https://api.<dominio>); only `telegram_set_webhook`
# uses it, on the server.
PUBLIC_URL=

# Notify bot (also the owner's small assistant) and operation chat. The webhook
# secret needs 32+ random characters on the server; in local, `make telegram-poll`
# does not need it.
NOTIFY_BOT_TOKEN=
NOTIFY_BOT_WEBHOOK_SECRET=
OWNER_SUPPORT_EMAIL=
OPS_TELEGRAM_CHAT_ID=

# Observability. Empty values disable external integrations locally.
SENTRY_DSN=
HEALTHCHECKS_PING_URL=
RELEASE_SHA=
SERVICE_NAME=web
# Local credential path (optional); Compose binds /dev/null while empty. Relative to
# deploy/compose/ (where compose.local.yaml/compose.prod.yaml live), not the repo root;
# the convention is var/google_sa.json, i.e. ../../var/google_sa.json from here.
GOOGLE_SERVICE_ACCOUNT_FILE=

# Retención destructiva: mantener false hasta aprobación humana explícita.
# El trabajo nocturno (03:00 UTC) comprueba este permiso también al ejecutarse.
RETENTION_CLEANUP_ENABLED=false
